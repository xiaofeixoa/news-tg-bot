# ============================================================
# AI News Radar - environment configuration
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================

APP_ENV=production
LOG_LEVEL=INFO

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Comma separated chat ids allowed to use the bot. Empty = nobody (fail closed).
ALLOWED_CHAT_IDS=
# Needed when api.telegram.org is unreachable from your server, e.g.
#   http://127.0.0.1:7890   (an https:// proxy works too; socks5:// needs
#   the extra aiohttp_socks package).
TELEGRAM_PROXY=
# Outbound proxy for the collectors as well (httpx reads these automatically).
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ---- Storage ----
DATABASE_URL=sqlite:///data/news.db
DATA_DIR=data
CONFIG_DIR=config
LOG_DIR=logs

# ---- LLM (OpenAI compatible, fully swappable) ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional cheaper/stronger models; fall back to LLM_MODEL when empty.
LLM_LIGHT_MODEL=
LLM_STRONG_MODEL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- Time & scheduling ----
TIMEZONE=Asia/Shanghai
RSS_FETCH_INTERVAL=600
HN_FETCH_INTERVAL=600
GITHUB_FETCH_INTERVAL=1800
REDDIT_FETCH_INTERVAL=1800
ARXIV_FETCH_INTERVAL=10800
YOUTUBE_FETCH_INTERVAL=1800
PROCESS_INTERVAL=600

# ---- Digests ----
DAILY_DIGEST_TIME=08:00
EVENING_DIGEST_TIME=20:00
MIN_ARTICLE_SCORE=45

# ---- Breaking news ----
BREAKING_NEWS_ENABLED=true
BREAKING_NEWS_THRESHOLD=90
MAX_BREAKING_NEWS_PER_DAY=5
BREAKING_COOLDOWN_MINUTES=60

# ---- Optional collector credentials ----
GITHUB_TOKEN=
